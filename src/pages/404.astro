---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { LINKS } from '../site';
---

<Base title="Page not found · Clubio POS">
  <main class="mx-auto flex min-h-screen max-w-md flex-col items-center justify-center gap-6 px-4 text-center">
    <Logo />
    <h1 class="text-3xl font-bold">Page not found</h1>
    <p class="text-slate-300">
      That page doesn’t exist. Looking for the app? Sign in there instead.
    </p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a
        href="/"
        class="inline-flex min-h-12 items-center justify-center rounded-xl bg-amber-500 px-6 font-semibold text-slate-950 hover:bg-amber-400"
      >
        Back to the home page
      </a>
      <a
        href={LINKS.signIn}
        class="inline-flex min-h-12 items-center justify-center rounded-xl border border-slate-700 px-6 font-semibold hover:border-amber-500 hover:text-amber-400"
      >
        Sign in
      </a>
    </div>
  </main>
</Base>
