---
import { LINKS, PLANS, TRIAL_DAYS, formatKes } from '../site';
---

<section id="pricing" class="mx-auto max-w-6xl px-4 py-20">
  <h2 class="text-3xl font-bold tracking-tight">Simple pricing, per outlet</h2>
  <p class="mt-3 max-w-2xl text-slate-300">
    Pay for each outlet that trades, monthly or ahead. Start with {TRIAL_DAYS} days free with every
    feature, then pick a plan.
  </p>
  <div class="mt-10 grid gap-6 md:grid-cols-2">
    {PLANS.map((p) => (
      <div
        class:list={[
          'flex flex-col rounded-2xl border p-8',
          'highlight' in p && p.highlight
            ? 'border-amber-500/60 bg-amber-500/5'
            : 'border-slate-800 bg-slate-900',
        ]}
      >
        <div class="flex items-center justify-between">
          <h3 class="text-xl font-bold">{p.name}</h3>
          {'highlight' in p && p.highlight && (
            <span class="rounded-full bg-amber-500 px-2.5 py-0.5 text-xs font-semibold text-slate-950">
              Most features
            </span>
          )}
        </div>
        <p class="mt-2 text-slate-300">{p.blurb}</p>
        <p class="mt-6">
          <span class="text-4xl font-black tabular-nums">{formatKes(p.price)}</span>
          <span class="text-slate-400"> / outlet / month</span>
        </p>
        <ul class="mt-6 flex-1 space-y-3">
          {p.features.map((f) => (
            <li class="flex gap-3 text-slate-200">
              <svg
                viewBox="0 0 24 24"
                class="mt-0.5 h-5 w-5 shrink-0 text-amber-400"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {f}
            </li>
          ))}
        </ul>
        <a
          href={LINKS.signup}
          class:list={[
            'mt-8 inline-flex min-h-12 items-center justify-center rounded-xl px-6 font-semibold',
            'highlight' in p && p.highlight
              ? 'bg-amber-500 text-slate-950 hover:bg-amber-400'
              : 'border border-slate-700 text-slate-100 hover:border-amber-500 hover:text-amber-400',
          ]}
        >
          Start free trial
        </a>
      </div>
    ))}
  </div>
  <p class="mt-6 text-sm text-slate-400">
    Save when you pay 3, 6 or 12 months ahead. Pay by M-Pesa. Prices in Kenya shillings.
  </p>
</section>
