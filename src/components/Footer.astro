---
import Logo from './Logo.astro';
import { BUSINESS, CONTACT, LINKS, whatsappUrl } from '../site';

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-800">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 pb-28 sm:grid-cols-3 md:pb-12">
    <div>
      <Logo />
      <p class="mt-3 text-sm text-slate-400">Point of sale for bars and clubs. {BUSINESS.city}.</p>
    </div>
    <div class="text-sm">
      <h2 class="font-semibold text-slate-200">Contact</h2>
      <ul class="mt-3 space-y-2 text-slate-400">
        <li>
          <a href={whatsappUrl()} target="_blank" rel="noopener" class="hover:text-amber-400">
            WhatsApp
          </a>
        </li>
        <li>
          <a href={`tel:${CONTACT.phoneTel}`} class="hover:text-amber-400">
            {CONTACT.phoneDisplay}
          </a>
        </li>
        <li>
          <a href={`mailto:${CONTACT.email}`} class="hover:text-amber-400">
            {CONTACT.email}
          </a>
        </li>
      </ul>
    </div>
    <div class="text-sm">
      <h2 class="font-semibold text-slate-200">SnowPOS</h2>
      <ul class="mt-3 space-y-2 text-slate-400">
        <li>
          <a href={LINKS.signIn} class="hover:text-amber-400">
            Sign in
          </a>
        </li>
        <li>
          <a href={LINKS.terms} class="hover:text-amber-400">
            Terms of service
          </a>
        </li>
        <li>
          <a href={LINKS.privacy} class="hover:text-amber-400">
            Privacy policy
          </a>
        </li>
      </ul>
    </div>
  </div>
  <p class="border-t border-slate-800 py-6 text-center text-xs text-slate-500">
    © {year} {BUSINESS.legalName}
  </p>
</footer>
