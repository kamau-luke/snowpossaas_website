---
import { LINKS, TRIAL_DAYS, whatsappUrl } from '../site';

/** An illustration of a shift close, drawn in HTML (swap for a real screenshot later) */
const counts = [
  { item: 'Tusker Lager 500ml', expected: 48, counted: 48 },
  { item: 'Gilbey’s Gin 750ml', expected: 6, counted: 5 },
  { item: 'Smirnoff Vodka 250ml', expected: 22, counted: 22 },
  { item: 'Kenya Cane 750ml', expected: 9, counted: 9 },
];
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute -top-40 left-1/2 h-96 w-[48rem] -translate-x-1/2 rounded-full bg-amber-500/10 blur-3xl"
    aria-hidden="true"
  ></div>
  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 md:py-24 lg:grid-cols-2">
    <div>
      <p class="mb-4 inline-flex rounded-full border border-amber-500/30 bg-amber-500/10 px-3 py-1 text-sm text-amber-300">
        Point of sale for Kenyan bars and clubs
      </p>
      <h1 class="text-4xl font-black tracking-tight text-balance sm:text-5xl lg:text-6xl">
        Stop losing stock and cash <span class="text-amber-400">between shifts.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-pretty text-slate-300">
        SnowPOS counts every bottle, keg and M-Pesa payment from one bartender to the next. When
        something goes missing, you know when it happened and whose shift it was.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={LINKS.signup}
          class="inline-flex min-h-12 items-center justify-center whitespace-nowrap rounded-xl bg-amber-500 px-6 font-semibold text-slate-950 hover:bg-amber-400"
        >
          Start your {TRIAL_DAYS}-day free trial
        </a>
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-12 items-center justify-center whitespace-nowrap rounded-xl border border-slate-700 px-6 font-semibold text-slate-100 hover:border-amber-500 hover:text-amber-400"
        >
          Ask for a demo on WhatsApp
        </a>
      </div>
      <p class="mt-4 text-sm text-slate-400">
        Every feature during the trial. Pay by M-Pesa only if you stay.
      </p>
    </div>

    <figure class="mx-auto w-full max-w-md" aria-label="Example: closing a bar shift in SnowPOS">
      <div class="rounded-2xl border border-slate-800 bg-slate-900 p-5 shadow-2xl shadow-black/40">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs uppercase tracking-wide text-slate-400">Main Bar · shift closed</p>
            <p class="font-semibold">Ann’s shift, Friday</p>
          </div>
          <span class="rounded-full bg-emerald-500/15 px-2.5 py-1 text-xs font-medium text-emerald-300">
            M-Pesa 37/37 checked
          </span>
        </div>
        <table class="mt-4 w-full text-sm">
          <thead class="text-left text-xs text-slate-400">
            <tr>
              <th class="pb-2 font-medium">Item</th>
              <th class="pb-2 text-right font-medium">Expected</th>
              <th class="pb-2 text-right font-medium">Counted</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            {counts.map((c) => {
              const short = c.counted < c.expected;
              return (
                <tr>
                  <td class="py-2 pr-2 text-slate-200">{c.item}</td>
                  <td class="py-2 text-right tabular-nums text-slate-400">{c.expected}</td>
                  <td
                    class:list={[
                      'py-2 text-right font-semibold tabular-nums',
                      short ? 'text-rose-400' : 'text-slate-100',
                    ]}
                  >
                    {c.counted}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <div class="mt-4 rounded-xl border border-rose-500/30 bg-rose-500/10 p-3 text-sm">
          <p class="font-medium text-rose-300">Short: 1 × Gilbey’s Gin 750ml = KES 1,850</p>
          <p class="mt-1 text-slate-300">
            Counted blind at close, so it shows on the shortages report under Ann’s shift.
          </p>
        </div>
      </div>
      <figcaption class="mt-3 text-center text-xs text-slate-500">
        Illustration with example data
      </figcaption>
    </figure>
  </div>
</section>
