---
const steps = [
  {
    title: 'Set up your club',
    body: 'Sign up, add your outlets and staff, and bring in your products from a spreadsheet (CSV).',
  },
  {
    title: 'Pair the bar’s phone or tablet',
    body: 'A manager pairs the device with a one-time code. Staff sign in on it with their own PIN.',
  },
  {
    title: 'Sell, count, close',
    body: 'Bartenders sell and count. You follow every outlet’s sales, stock and shortages from your phone.',
  },
];
---

<section id="how-it-works" class="border-y border-slate-800 bg-slate-900/40">
  <div class="mx-auto max-w-6xl px-4 py-20">
    <h2 class="text-3xl font-bold tracking-tight">Up and running in an afternoon</h2>
    <ol class="mt-10 grid gap-6 md:grid-cols-3">
      {steps.map((s, i) => (
        <li class="rounded-2xl border border-slate-800 bg-slate-950 p-6">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-amber-500 font-bold text-slate-950">
            {i + 1}
          </span>
          <h3 class="mt-4 font-semibold">{s.title}</h3>
          <p class="mt-2 text-slate-300">{s.body}</p>
        </li>
      ))}
    </ol>
    <p class="mt-6 text-sm text-slate-400">
      Works in the browser on any phone, tablet or computer. Nothing to install.
    </p>
  </div>
</section>
