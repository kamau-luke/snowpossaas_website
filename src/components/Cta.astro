---
import { CONTACT, LINKS, TRIAL_DAYS, whatsappUrl } from '../site';
---

<section id="contact" class="mx-auto max-w-6xl px-4 py-20">
  <div class="rounded-3xl border border-amber-500/30 bg-gradient-to-br from-amber-500/15 to-slate-900 p-8 text-center md:p-14">
    <h2 class="text-3xl font-black tracking-tight text-balance md:text-4xl">
      Try it free for {TRIAL_DAYS} days
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-slate-300">
      Set up your bar today and run your next shift on Clubio POS. Want us to show you first? Get in
      touch and we’ll come to you or do a call.
    </p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a
        href={LINKS.signup}
        class="inline-flex min-h-12 items-center justify-center rounded-xl bg-amber-500 px-6 font-semibold text-slate-950 hover:bg-amber-400"
      >
        Start free trial
      </a>
      <a
        href={whatsappUrl()}
        target="_blank"
        rel="noopener"
        class="inline-flex min-h-12 items-center justify-center rounded-xl bg-emerald-600 px-6 font-semibold text-white hover:bg-emerald-500"
      >
        WhatsApp us
      </a>
    </div>
    <div class="mt-6 flex flex-col justify-center gap-2 text-slate-300 sm:flex-row sm:gap-6">
      <a
        href={`tel:${CONTACT.phoneTel}`}
        class="inline-flex min-h-11 items-center justify-center hover:text-amber-400"
      >
        Call {CONTACT.phoneDisplay}
      </a>
      <a
        href={`mailto:${CONTACT.email}`}
        class="inline-flex min-h-11 items-center justify-center hover:text-amber-400"
      >
        {CONTACT.email}
      </a>
    </div>
  </div>
</section>
